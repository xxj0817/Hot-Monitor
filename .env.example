# ===== Hot-Monitor env template (pure ASCII) =====
# Copy to .env and fill real values (.env is git-ignored)

# OpenRouter AI key. Get at https://openrouter.ai -> Keys.
# Free models (id ends with :free) work without purchased credits,
# e.g. default minimax/minimax-m3:free. Paid models need credits.
OPENROUTER_API_KEY=

# twitterapi.io key (optional). Get at https://twitterapi.io dashboard.
# Leave empty to disable the Twitter/X source (UI will hint it).
TWITTER_API_KEY=

# Service port (default 3000)
PORT=3000
